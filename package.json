{
  "name": "lyricglow",
  "version": "0.5.3",
  "description": "Real-time synchronized lyrics and music metadata display for macOS.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "bash scripts/release.sh",
    "quality": "npm run dead-code && npm run duplicates && npm run lint",
    "dead-code": "knip",
    "duplicates": "jscpd ./src --min-lines 5",
    "outdated": "npm-check-updates",
    "lint": "biome check ./src",
    "format": "biome format ./src --write"
  },
  "keywords": [
    "lyrics",
    "synchronized-lyrics",
    "music",
    "now-playing",
    "spotify",
    "apple-music",
    "electron",
    "macos",
    "music-player",
    "lyrics-display",
    "real-time-lyrics",
    "spotify-lyrics",
    "music-metadata",
    "artist-info",
    "album-artwork",
    "rtl-support",
    "persian-lyrics",
    "arabic-lyrics",
    "multilingual"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.9.1",
    "@types/node-fetch": "^2.6.13",
    "electron": "^33.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "jscpd": "^4.0.8",
    "knip": "^5.83.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-store": "^10.0.0",
    "node-fetch": "^2.7.0"
  }
}
