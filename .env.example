# ==========================================
# LyricGlow - Environment Variables
# ==========================================
# Copy this file to .env and fill in your own values.
# Both keys are optional: without them the app still runs, it just skips
# Spotify login and uses the default cache lifetime.

# Spotify Client ID (required for the Top Tracks & Albums features)
# Get your own from: https://developer.spotify.com/dashboard
# Redirect URI must be: musicdisplay://callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Cache duration in hours (default: 168 = 7 days)
CACHE_DURATION_HOURS=168
